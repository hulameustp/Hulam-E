APP_NAME=Hulame
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hulame-backend.up.railway.app

DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# Production optimizations
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync
LOG_CHANNEL=stack
LOG_LEVEL=error

# CORS settings for frontend
CORS_ALLOWED_ORIGINS=https://hulame-frontend.up.railway.app

# Mail settings (configure for your needs)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@hulame.com"
MAIL_FROM_NAME="${APP_NAME}"
