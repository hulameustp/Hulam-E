{
  "rewrites": [
    { "source": "/(.*)", "destination": "/front/index.html" }
  ],
  "buildCommand": "cd front && npm ci && npm run build",
  "outputDirectory": "front/build",
  "installCommand": "cd front && npm ci",
  "env": {
    "REACT_APP_API_URL": "https://hulame-backend.up.railway.app/api",
    "REACT_APP_ENV": "production"
  }
}
